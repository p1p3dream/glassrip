      .sticky-text { font-family: Inter, -apple-system, Segoe UI, Roboto, sans-serif; font-size: 12px; font-weight: 500; fill: #422006; }
      .grid-text { font-family: Inter, -apple-system, Segoe UI, Roboto, sans-serif; font-size: 12px; font-weight: 600; fill: #1e3a8a; }
