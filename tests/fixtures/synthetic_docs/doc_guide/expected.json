      {
        "kind": "paragraph",
        "content": "This page explains how to run the parcel queue on a laptop and how to read its dashboard."
      },
      {
        "kind": "heading",
        "level": 2,
        "content": "Install"
      },
      {
        "kind": "list",
        "content": "Install the queue tool\nCreate a local config file\nStart the worker"
      },
      {
        "kind": "code",
        "lang": "shell",
        "content": "queue init --local\nqueue worker start --threads 4"
      },
